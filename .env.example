# Copy to .env and fill in. Never commit .env. Same variables go in Vercel -> Settings -> Environment Variables.
S3_BUCKET=hike-mpi
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Password for upload.html (upload, list, delete). Uploads are disabled when empty.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
UPLOAD_KEY=
# Optional viewing password for the dashboard pages.
DASHBOARD_KEY=
